{
  "name": "resonance-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:pill": "vite --config vite.pill.config.ts --host 127.0.0.1",
    "build": "vite build",
    "build:pill": "vite build --config vite.pill.config.ts",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "test:server": "node --test server/*.test.mjs",
    "test:voice": "node --experimental-strip-types --test src/services/speechSegmentBuffer.test.ts src/services/voicePipeline.test.mjs",
    "test:pill": "node --experimental-strip-types --test src/components/transcription-pill/pillPresentation.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:server && npm run test:voice && npm run test:pill && npm run build && npm run build:pill"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.30",
    "clsx": "2.1.1",
    "lucide-react": "^1.27.0",
    "onnxruntime-web": "1.27.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  }
}
